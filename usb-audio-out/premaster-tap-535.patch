+// usb-audio-out pre-master tap, only b946c3b8 / JP21. 0x17b0148 is the DspChain input
+// gather: it sums the node's input connections (with their ramped gains) into its
+// output pair, before the node's own DSP chain runs. For the Mixer's main
+// OutputChannel (Mixer +0x70, output = MixerBuffers pairs 0/1) that chain holds the
+// master Volume GainDsp, so right after the gather the pair is the main mix before
+// the master knob. Every other node passes straight through: two loads and a compare.
+// The set recorder is a RecorderChannel node (vtable 0x2b968e4) whose own process
+// (0x17b0fcc) gathers its inputs through the same 0x17b0148 before its chain
+// (recording gain, RecorderDsp writer). So both points are seen here.
+static uint32_t premaster_sum_jump[2];
+static void (*premaster_sum_native)(void *, int, float **, int);
+static void *premaster_node;
+static float **premaster_out;
+static void *recorder_vtable;
+
+static void premaster_sum(void *node, int channels, float **out, int frames) {
+    premaster_sum_native(node, channels, out, frames);
+    if (!out || frames <= 0 || channels < 1 || !node) return;
+    int which;
+    if (node == __atomic_load_n(&premaster_node, __ATOMIC_RELAXED) &&
+        out == __atomic_load_n(&premaster_out, __ATOMIC_RELAXED))
+        which = TAP_MASTER_SUM;
+    else if (*(void **)node == recorder_vtable)
+        which = TAP_RECORDER;
+    else
+        return;
+    tap_measure(which, out[0], frames);
+    if (__atomic_load_n(&live_premaster, __ATOMIC_RELAXED) != which) return;
+    if (__atomic_load_n(&live_premaster_dry, __ATOMIC_RELAXED)) {
+        sc_tap_push(&live_tap, out[0], channels > 1 ? out[1] : NULL, (uint32_t)frames);
+    } else {
+        // Engine's buffer is the recorder's input: process a copy, never the original.
+        static float copy_l[1024], copy_r[1024];
+        float *r_in = channels > 1 ? out[1] : NULL;
+        for (int done = 0; done < frames;) {
+            unsigned n = (unsigned)(frames - done) > 1024u ? 1024u : (unsigned)(frames - done);
+            memcpy(copy_l, out[0] + done, n * sizeof(float));
+            if (r_in) memcpy(copy_r, r_in + done, n * sizeof(float));
+            tap_master_fx(copy_l, r_in ? copy_r : NULL, n);
+            sc_tap_push(&live_tap, copy_l, r_in ? copy_r : NULL, n);
+            done += (int)n;
+        }
+    }
+    __atomic_fetch_add(&premaster_pushes, 1, __ATOMIC_RELAXED);
+}
