+    uint32_t scaled = peak >= 4000.0f ? 4000000000u : (uint32_t)(peak * 1e6f);
+    if (scaled > __atomic_load_n(&tap_peak[which], __ATOMIC_RELAXED))
+        __atomic_store_n(&tap_peak[which], scaled, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&tap_blocks[which], 1, __ATOMIC_RELAXED);
