+            list.push({label: String(ch), translator: scAssignTranslator("/Engine/Mixer/Channel" + ch + "/DJFx/Assigned")})
+        list.push({label: "M", translator: scAssignTranslator("/Engine/Mixer/Main/DJFx/Assigned")})
