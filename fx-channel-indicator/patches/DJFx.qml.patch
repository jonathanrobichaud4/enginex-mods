+    // fx-channel-indicator mod: which mixer channel the FX unit is assigned to.
+    // Single-unit consoles keep one boolean per channel plus Main. On SC LIVE 4 the
+    // FX assign rotary (DJFxAssignSwitch, CC 40) sets exactly one of them. Send-style
+    // units (PRIME 4) store assignment differently, so the readout stays hidden there.
+    function scAssignTranslator(path) {
+        const p = Planck.getProperty(path)
+        return p && p.translator ? p.translator : null
