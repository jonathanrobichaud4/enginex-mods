+
+    readonly property QObjProperty pSiTrackUri: Planck.getProperty(`/Engine/Deck${deckIndex}/Track/TrackUri`)
+    // ---- Streaming Icons mod ----------------------------------------------------------------
+    // EngineX plays every OmniSource track through Engine's TIDAL player, so Engine shows the TIDAL
+    // icon for all of them. EngineX's gateway still knows each track's real service: its track
+    // record (GET /v1/tracks/<id> on the deck's own gateway) starts the copyright field with the
+    // service's label, e.g. "Spotify [124 BPM 8A]". Answers are cached and shared by every view.
+    readonly property string siUri: pSiTrackUri && pSiTrackUri.translator ? pSiTrackUri.translator.string : ""
+    property string siService: ""
+    onSiUriChanged: siLookup()
+    Component.onCompleted: siLookup()
+    readonly property string siIcon: {
+        switch (siService) {
+        case "spotify": return "data:image/png;base64,"
+        case "deezer": return "data:image/png;base64,"
+        case "netease": return "data:image/png;base64,"
+        case "soundcloud": return "qrc:/Skins/UIKit/Icons/SourceSoundCloud.png"
+        case "beatport": return "qrc:/Skins/UIKit/Icons/SourceBeatport%20LINK.png"
+        case "applemusic": return "qrc:/Skins/UIKit/Icons/SourceAppleMusic.png"
+        case "usb": return "qrc:/Skins/UIKit/Icons/SourceUSB.png"
+        default: return ""
+        }
+    }
+    function siServiceOf(copyright) {
+        const l = String(copyright || "")
+        const labels = [["Spotify", "spotify"], ["Deezer", "deezer"], ["\u7f51\u6613\u4e91\u97f3\u4e50", "netease"],
+                        ["SoundCloud", "soundcloud"], ["Beatport", "beatport"], ["Apple Music", "applemusic"], ["USB/SD", "usb"]]
+        for (const [label, key] of labels)
+            if (l === label || l.startsWith(label + " [")) return key
+        return ""  // a real TIDAL track (its copyright is the record label's) or not known
+    }
+    function siLookup() {
+        const m = /^streaming:\/\/TIDAL\/Track\/(\d+)$/.exec(siUri || "")
+        siService = ""
+        if (!m) return
+        const id = m[1], want = siUri
+        const c = Math.siStreamingIcons || (Math.siStreamingIcons = { known: {}, misses: {}, waiting: {} })
+        if (id in c.known) { siService = c.known[id]; return }
+        if (c.misses[id] && Date.now() - c.misses[id] < 60000) return  // not one of EngineX's; ask again later
+        const done = function(k) { try { if (siUri === want) siService = k } catch (e) {} }
+        if (c.waiting[id]) { c.waiting[id].push(done); return }
+        c.waiting[id] = [done]
+        const x = new XMLHttpRequest()
+        x.onreadystatechange = function() {
+            if (x.readyState !== XMLHttpRequest.DONE) return
+            let k = ""
+            if (x.status === 200) { try { k = siServiceOf(JSON.parse(x.responseText).copyright) } catch (e) {} }
+            if (k) c.known[id] = k
+            else c.misses[id] = Date.now()
+            const waiting = c.waiting[id] || []
+            delete c.waiting[id]
+            for (const f of waiting) f(k)
+        }
+        x.open("GET", "http://127.0.0.1:8080/v1/tracks/" + id + "?countryCode=US")
+        x.send()
+    }
+    // ------------------------------------------------------------------------------------------
