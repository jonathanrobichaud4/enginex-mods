--- a/Skins/Embedded/Views/BrowseView/Components/Components/ProviderIcon.qml
+++ b/Skins/Embedded/Views/BrowseView/Components/Components/ProviderIcon.qml
@@ -2,11 +2,42 @@
 import EngineOS.UI.Style 1.0
 import "../../../../Items"
 
+// Streaming Icons mod: the small service icon next to each track in the browser.
+//
+// EngineX's OmniSource plays tracks from Spotify, Deezer, NetEase, SoundCloud, Beatport and
+// Apple Music through Engine's TIDAL player, so Engine marks every one of them with the TIDAL
+// icon (their provider label stays "TIDAL"). EngineX keeps the service you're browsing in
+// root.scScope, and every streaming row on screen comes from it, so the icon follows that.
+// Real TIDAL browsing, local tracks and anything not recognised keep Engine's own icon.
 Item {
+    id: providerIconRoot
     width: 24
     height: 24
     visible: image.source != ""
 
+    // "" outside EngineX or before it has picked a service.
+    readonly property string scope: (typeof root !== "undefined" && root && root.scScope) ? String(root.scScope) : ""
+    readonly property bool streamingRow: (row.streamingProviderName || "") !== ""
+    readonly property string iconDir: "qrc:/Skins/UIKit/Icons/"
+    // Engine has no Spotify, Deezer or NetEase icon; these are single-colour versions of the
+    // logos, tinted like the rest of the list.
+    readonly property string spotifyIcon: "data:image/png;base64,"
+    readonly property string deezerIcon: "data:image/png;base64,"
+    readonly property string neteaseIcon: "data:image/png;base64,"
+
+    readonly property string serviceIcon: {
+        if (!streamingRow) return ""
+        switch (scope) {
+        case "spotify": return spotifyIcon
+        case "deezer": return deezerIcon
+        case "netease": return neteaseIcon
+        case "soundcloud": return iconDir + "SourceSoundCloud.png"
+        case "beatport": return iconDir + "SourceBeatport%20LINK.png"
+        case "applemusic": return iconDir + "SourceAppleMusic.png"
+        default: return ""   // tidal, or no service picked yet
+        }
+    }
+
     ColoredImage {
         id: image
         objectName: "Browser_TrackList_ViewDelegate_ProviderIcon"
@@ -17,6 +48,6 @@
         height: (src.height / src.width) * width
         visible: source != ""
         color: Style.icon01Color
-        source: row.modelData.providerIconUri ?? ""
+        source: providerIconRoot.serviceIcon !== "" ? providerIconRoot.serviceIcon : (row.modelData.providerIconUri ?? "")
     }
 }
